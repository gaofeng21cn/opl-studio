  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/use-sync-external-store": "1.5.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.8.3",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "npm run build:webui && node scripts/dev-webui-server.mjs",
    "dev:desktop": "npm run build:desktop && electron .",
    "webui": "npm run dev",
    "start:headless": "node scripts/headless/run.mjs",
    "headless:install": "node scripts/install-headless.mjs install",
    "headless:status": "node scripts/install-headless.mjs status",
    "headless:start": "node scripts/install-headless.mjs start",
    "headless:stop": "node scripts/install-headless.mjs stop",
    "headless:restart": "node scripts/install-headless.mjs restart",
    "headless:update": "node scripts/install-headless.mjs update",
    "headless:rollback": "node scripts/install-headless.mjs rollback",
    "headless:uninstall": "node scripts/install-headless.mjs uninstall",
    "build": "node scripts/build-renderer.mjs",
    "build:webui": "node scripts/build-webui.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "vendor:dsh-gui": "node scripts/deepseek-harness-gui-vendor.mjs sync",
    "verify:dsh-gui": "node scripts/deepseek-harness-gui-vendor.mjs check",
    "dsh:status": "node scripts/dsh-upgrade.mjs status",
    "dsh:preflight": "node scripts/dsh-upgrade.mjs preflight",
    "test:dsh-upgrade": "node --test scripts/dsh-upgrade.test.mjs",
    "package": "node scripts/package-candidate-carriers.mjs",
    "package:desktop": "npm run build:desktop && electron-builder --dir --config electron-builder.yml",
    "full:contract": "node scripts/desktop/full-payload.mjs",
    "build:full": "node scripts/desktop/build-full.mjs",
    "qualify:full": "node scripts/desktop/build-full.mjs --qualify-only",
    "dist:desktop": "npm run build:desktop && electron-builder --config electron-builder.yml --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --config electron-builder.yml --publish never && npm run qualify:desktop:mac",
    "dist:windows": "npm run build:desktop && electron-builder --win --config electron-builder.yml --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux --config electron-builder.yml --publish never",
    "build:docker": "docker build --tag one-person-lab-app:headless-candidate .",
    "plan:oci:multiarch": "node scripts/oci/build-plan.mjs",
    "smoke:desktop-live": "node scripts/smoke-desktop-live.mjs",
    "smoke:preview": "node scripts/desktop/preview-smoke.mjs",
    "test:desktop": "node --test desktop/accessibility-qualification.test.mjs desktop/app-log-directory.test.mjs desktop/desktop-contract.test.mjs desktop/shutdown.test.mjs desktop/tray.test.mjs desktop/updater.test.mjs && npm run test:desktop-distribution",
    "test:desktop-distribution": "node --test tests/desktop/*.test.mjs",
    "test:headless": "node --test tests/headless/*.test.mjs",
    "test:oci": "node --test tests/oci/*.test.mjs tests/headless/docker-contract.test.mjs",
    "test:gateway-account-projection": "bun test tests/workbench/gateway-account-cache.test.mts && bun run scripts/gateway-account-projection-regression.ts",
    "test:package-projection": "bun test tests/workbench/package-projection.test.mts",
    "test:runtime-projection": "bun test tests/workbench/runtime-projection.test.mts tests/workbench/service-recovery-model.test.mts",
    "test:ui-contributions": "bun test tests/workbench/ui-contribution-composition.test.mts",
    "test:client-cordis": "bun test tests/conformance/client-cordis-conformance.test.mts",
    "validate:client-conformance": "bun run scripts/validate-client-conformance.mjs",
    "test:storage-migration": "bun test tests/workbench/storage-migration.test.mts",
    "test:thread-directory-projection": "bun test tests/workbench/thread-directory-projection.test.mts",
    "test:webui-host": "node --test scripts/webui-host/host-core.test.mjs scripts/webui-host/thread-adapter.test.mjs scripts/webui-host/thread-workspace-service.test.mjs scripts/webui-host/http-host.test.mjs scripts/webui-host/dsh-tool-mcp.test.mjs scripts/webui-host/opl-passthrough.test.mjs scripts/webui-host/gateway-account-login.test.mjs scripts/webui-host/native-app-updater.test.mjs",
    "test:threads": "npm run test:thread-directory-projection && bun test tests/workbench/canonical-thread-reconcile.test.mts && npm run test:webui-host && node --test tests/renderer/thread-renderer-source.test.mjs",
    "test:source": "npm run typecheck && npm run test:dsh-upgrade && npm run test:desktop && npm run test:headless && npm run test:oci && npm run test:gateway-account-projection && npm run test:package-projection && npm run test:runtime-projection && npm run test:ui-contributions && npm run test:client-cordis && npm run test:storage-migration && npm run test:threads && npm run validate:candidate",
    "validate:candidate": "node scripts/validate-opl-studio-candidate.mjs",
    "validate:state-model": "node scripts/validate-state-model.mjs",
    "validate:package": "node scripts/validate-desktop-package.mjs",
    "qualify:desktop:distribution": "node scripts/validate-desktop-package.mjs --distribution",
    "qualify:desktop:mac": "node scripts/desktop/macos-distribution.mjs",
    "qualify:desktop:mac:release": "node scripts/desktop/macos-distribution.mjs --require-release-trust --require-public-feed",
    "qualify:desktop:updater:local": "node scripts/desktop/qualify-local-updater.mjs",
    "qualify:desktop:clean-vm": "node scripts/desktop/qualify-clean-vm.mjs",
    "diagnose:gateway:persistence": "node scripts/desktop/diagnose-gateway-credential-persistence.mjs",
    "smoke:webui": "node scripts/smoke-webui.mjs",
    "smoke:visual": "node scripts/smoke-visual.mjs",
    "smoke:docker": "node tests/headless/docker-smoke.mjs",
    "smoke:docker:lifecycle": "node tests/headless/docker-lifecycle-smoke.mjs",
    "test": "npm run test:source",
    "test:full": "npm run test:source && npm run validate:state-model && npm run smoke:webui && npm run smoke:visual && npm run package && npm run validate:package"
  }
}
