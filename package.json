  },
  "author": {
    "name": "Feng Gao",
    "email": "gaofeng21cn@hotmail.com"
  },
  "main": "desktop/main.mjs",
  "license": "Apache-2.0",
  "dependencies": {
    "@codemirror/state": "^6.7.1",
