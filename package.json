{
  "name": "opl-studio",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "First-party DeepSeek Harness/Cordis Application Host for One Person Lab App across desktop and headless carriers.",
  "homepage": "https://github.com/gaofeng21cn/opl-studio",
  "repository": {
    "type": "git",
