+})((() => {
+  let pending = Promise.resolve();
+  return (input, init = {}) => {
+    if (input !== 'api/settings-search-log' && input !== 'api/settings-search-log?count=1') {
+      return globalThis.fetch(input, init);
+    }
+    const run = async () => {
+      const method = init.method || 'GET';
+      if (!['GET', 'POST'].includes(method) || (init.body !== undefined && typeof init.body !== 'string')) {
+        throw new Error('Invalid settings search log request');
+      }
+      if (new TextEncoder().encode(init.body || '').byteLength > 256 * 1024) {
+        return new Response(JSON.stringify({ ok: false, reason: 'request-too-large' }), { status: 413 });
+      }
+      if (typeof window.oplStudio?.requestSettingsSearchLog !== 'function') {
+        throw new Error('Settings search log transport unavailable');
+      }
+      const result = await window.oplStudio.requestSettingsSearchLog({
+        method, count: input.endsWith('?count=1'),
+        ...(method === 'POST' ? { body: init.body || '' } : {}),
+      });
+      return new Response(result.body, { status: result.status, headers: { 'content-type': 'application/json' } });
+    };
+    // A clear/read must observe earlier append requests even on a slow Web link.
+    const result = pending.then(run);
+    pending = result.then(() => undefined, () => undefined);
+    return result;
+  };
+})());
