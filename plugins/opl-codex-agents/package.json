{
  "name": "@gaofeng21cn/opl-codex-agents",
  "version": "0.1.3",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./parent-transport": "./lib/parent-transport.mjs",
    "./workbench-profile": "./lib/workbench-profile.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "description": "Official DSH Agent driver adapter for the existing persistent Codex App Server.",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.2-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "dsh-superagent": "0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-superagent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gaofeng21cn/opl-studio.git",
    "directory": "plugins/opl-codex-agents"
  }
}
