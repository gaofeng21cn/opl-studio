{
  "name": "@one-person-lab/opl-studio-client",
  "version": "0.1.2",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@one-person-lab/opl-mcp-apps"]
    },
    "manifestVersion": 1
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "description": "OPL renderer integration for the DSH client module system.",
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
